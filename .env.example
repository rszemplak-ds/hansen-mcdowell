NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — create a project, then copy its values here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-08

# Resend — sending requires these env vars.
# Sanity siteSettings.email controls the recipient when set; CONTACT_TO_EMAIL is the fallback.
#
# Local testing (before a domain is verified): send from onboarding@resend.dev and
# set CONTACT_TO_EMAIL_OVERRIDE to the email on your Resend account. Resend rejects
# any other sender domain or recipient until a domain is verified.
#
# Production: verify a domain at https://resend.com/domains, use an address on that
# domain as the sender, and leave CONTACT_TO_EMAIL_OVERRIDE unset (it is ignored there).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Hansen McDowell Website <onboarding@resend.dev>
CONTACT_TO_EMAIL=hansenmcdowell@yahoo.com
CONTACT_TO_EMAIL_OVERRIDE=
